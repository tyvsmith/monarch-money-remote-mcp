# --- Runtime (also pushed to Secret Manager by scripts/deploy.ts --bootstrap / --rotate-secrets) ---
MONARCH_EMAIL=you@example.com
MONARCH_PASSWORD=your-password
MONARCH_MFA_SECRET=your-totp-secret
# Device UUID Monarch trusts for this login. Generated and written here by
# `npm run monarch:enroll`; keep it stable across deploys.
MONARCH_DEVICE_UUID=
# Expose the 24 write tools (default off: read-only). Forwarded to Cloud Run by
# scripts/deploy.ts on every deploy; also read by `npm run gen-openapi`.
MONARCH_ENABLE_WRITES=0
# Local session file written by `npm run monarch:enroll` (gitignored). Cloud Run
# uses the monarch-session secret instead.
# MONARCH_SESSION_FILE=.monarch-session.json
WRAPPER_API_KEY=generate-with-openssl-rand-base64-48
PORT=8080

# --- OAuth 2.1 (generated automatically by deploy:bootstrap; local-dev only) ---
# Leave unset to disable the OAuth path in dev. Set both to enable it.
# AUTH_USER_EMAIL=user@monarch-money-remote-mcp.local
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# Public URL the AS uses for the `iss` claim and discovery (defaults to
# http://localhost:8080 in dev). On Cloud Run scripts/deploy.ts sets this to
# the service URL on the second deploy pass.
# ISSUER_URL=

# --- Deploy-time only (consumed by scripts/deploy.ts) ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
GCP_SERVICE=monarch-bridge
